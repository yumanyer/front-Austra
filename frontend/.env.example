# AustralFinance Frontend Environment Variables
# WDK (Wallet Development Kit) by Tether Configuration

# WDK Wallet Configuration
WDK_WALLET_ID=australfinance-wallet
WDK_NETWORKS=mainnet,sepolia
WDK_RPC_URL=https://Sepolia.infura.io/v3/your-project-id
WDK_CHAIN=1  # 1=mainnet, 11155111=sepolia

# optional: if using gasless modules (Track 2)
# WDK_PAYMASTER_URL=https://paymaster.candide.sh
# WDK_PAYMASTER_TOKEN=0xyour-paymaster-token
# WDK_BUNDLER_URL=https://bundler.candide.sh

# Backend API Configuration (existing)
API_BASE_URL=http://127.0.0.1:3000
USE_DEMO_DATA=true  # set to false to use real backend

# Demo mode (existing)
DEMO_MODE=true  # set to false for real data