# AustralFinance backend example configuration.
# Copy to backend/.env on the VPS and replace only the values required by the deployment.
# Never commit backend/.env, private keys or API credentials.

# HTTP server. Nginx proxies /api/* to this loopback listener.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# External market data.
DATA912_BASE_URL=https://data912.com
DATA912_TIMEOUT_MS=5000

# Oracle and pricing.
ORACLE_SYMBOL=YPF
ORACLE_LOCAL_SYMBOL=YPFD
ORACLE_POLL_INTERVAL_MS=30000
ORACLE_EMA_ALPHA=0.2
ORACLE_CIRCUIT_BREAKER_PCT=0.10
ORACLE_BREAKER_RELEASE_TICKS=3
ORACLE_ADR_RATIO=10
ORACLE_SPREAD_MAX_PCT=0.02
ORACLE_CCL_MAX_DEVIATION_PCT=0.03
ORACLE_CCL_REFERENCE_COUNT=10
ORACLE_STALE_THRESHOLD_S=60
ORACLE_SEED_CLOSES=5
ORACLE_SIMULATED_WALK=false

# HIP-3 / HyperCore. Keep disabled and dry-run until credentials and venue checks are complete.
HIP3_ENABLED=false
HIP3_DRY_RUN=true
HIP3_TESTNET=true
HIP3_DEX=arg
HIP3_COIN=YPF
HIP3_SZ_DECIMALS=2
HIP3_FULL_NAME=austral.fi Argentine Markets
HIP3_COLLATERAL_TOKEN=0
HIP3_MARGIN_TABLE_ID=5
HIP3_MARGIN_MODE=strictIsolated
HIP3_MIN_STAKE_HYPE=100
HIP3_MAX_GAS=
HIP3_PUBLISH_INTERVAL_MS=3000
HIP3_ORACLE_UPDATER_KEY=

# HyperEVM mirror pusher. Leave empty to keep the pusher disabled.
ORACLE_CONTRACT_ADDRESS=
PUSHER_PRIVATE_KEY=
ORACLE_ABI_NAME=YPFOracle
PUSH_INTERVAL_MS=30000
HYPERLIQUID_TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
HYPERLIQUID_CHAIN_ID=998
